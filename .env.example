# =====================================================
# FORTIVO - Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit your actual .env file.
# =====================================================

# =====================================================
# AI Configuration
# =====================================================

# Google Gemini API Key
# Get one from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------

# xAI Grok API Key (Optional)
# Get one from: https://console.x.ai/
GROK_API_KEY=

# Grok model
GROK_MODEL=grok-4

# =====================================================
# Backend Configuration
# =====================================================

# Backend host
BACKEND_HOST=127.0.0.1

# Backend port
BACKEND_PORT=8000

# Logging level
LOG_LEVEL=INFO

# =====================================================
# Frontend Configuration
# =====================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Demo mode
# true  -> Uses mock/demo data
# false -> Uses the real backend
NEXT_PUBLIC_DEMO_MODE=false

# =====================================================
# Scanner Configuration
# =====================================================

# Optional overrides if the binaries are not on PATH

TRIVY_PATH=trivy

SEMGREP_PATH=semgrep

# =====================================================
# Optional Limits
# =====================================================

# Maximum repository size in MB
MAX_REPO_SIZE_MB=500

# Scan timeout in seconds
SCAN_TIMEOUT=600